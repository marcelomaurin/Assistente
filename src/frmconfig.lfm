        Left = 10
        Height = 23
        Top = 35
        Width = 350
        ItemHeight = 15
        OnChange = cbProviderChange
        Style = csDropDownList
        TabOrder = 0
      end
      object lblModel: TLabel
        Left = 10
        Height = 15
        Top = 75
        Width = 44
        Caption = 'Modelo:'
        ParentColor = False
      end
      object cbModel: TComboBox
        Left = 10
        Height = 23
        Top = 95
        Width = 350
        ItemHeight = 15
        TabOrder = 1
      end
      object lblToken: TLabel
