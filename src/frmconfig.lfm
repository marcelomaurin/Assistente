    TabOrder = 0
    object tsIA: TTabSheet
      Caption = 'IA / ChatGPT'
      ClientHeight = 402
      ClientWidth = 372
      object lblProvider: TLabel
        Left = 10
        Height = 15
        Top = 15
        Width = 51
        Caption = 'Provedor:'
