object frmmain: Tfrmmain
  Left = 600
  Height = 650
  Top = 150
  Width = 420
  Caption = 'Assistente Virtual'
  ClientHeight = 650
  ClientWidth = 420
  LCLVersion = '4.4.0.0'
  OnCreate = FormCreate
  object pnlTop: TPanel
    Left = 0
    Height = 180
    Top = 0
    Width = 420
    Align = alTop
    ClientHeight = 180
    ClientWidth = 420
    TabOrder = 0
    object GifAnim1: TGifAnim
      Left = 10
      Height = 160
      Top = 10
      Width = 160
      Animate = False
      AutoSize = False
      FileName = 'robo8.gif'
    end
    object pnlTopControls: TPanel
      Left = 180
      Height = 160
      Top = 10
      Width = 230
      Align = alRight
      BevelOuter = bvNone
      ClientHeight = 160
      ClientWidth = 230
      TabOrder = 0
      object btIniciar: TButton
        Left = 10
        Height = 40
        Top = 20
        Width = 210
        Caption = '▶ Iniciar Assistente'
        OnClick = btIniciarClick
        TabOrder = 0
      end
      object btAbrirConfig: TButton
        Left = 10
        Height = 40
        Top = 80
        Width = 210
        Caption = '⚙ Configurações...'
        OnClick = btAbrirConfigClick
        TabOrder = 1
      end
    end
  end
  object pnlChat: TPanel
    Left = 0
    Height = 330
    Top = 180
    Width = 420
    Align = alClient
    ClientHeight = 330
    ClientWidth = 420
    TabOrder = 1
    object pnlHistoricoHeader: TPanel
      Left = 1
      Height = 35
      Top = 1
      Width = 418
      Align = alTop
      BevelOuter = bvNone
      ClientHeight = 35
      ClientWidth = 418
      TabOrder = 0
      object lblHistorico: TLabel
        Left = 10
        Height = 15
        Top = 10
        Width = 118
        Caption = 'Histórico da Conversa:'
        Font.Style = [fsBold]
        ParentColor = False
      end
      object btSpeaker: TButton
        Left = 300
        Height = 28
        Top = 3
        Width = 110
        Caption = '🔊 Voz ON'
        OnClick = btSpeakerClick
        TabOrder = 0
      end
    end
    object memHistorico: TMemo
      Left = 1
      Height = 293
      Top = 36
      Width = 418
      Align = alClient
      ReadOnly = True
      ScrollBars = ssVertical
      TabOrder = 1
    end
  end
  object pnlPergunta: TPanel
    Left = 0
    Height = 140
    Top = 510
    Width = 420
    Align = alBottom
    ClientHeight = 140
    ClientWidth = 420
    TabOrder = 2
    object lblPergunta: TLabel
      Left = 10
      Height = 15
      Top = 8
      Width = 73
      Caption = 'Sua pergunta:'
      ParentColor = False
    end
    object memPergunta: TMemo
      Left = 10
      Height = 95
      Top = 28
      Width = 290
      OnKeyPress = memPerguntaKeyPress
      ScrollBars = ssVertical
      TabOrder = 0
    end
    object btEnviar: TButton
      Left = 310
      Height = 44
      Top = 28
      Width = 100
      Caption = '✈ Enviar'
      OnClick = btEnviarClick
      TabOrder = 1
    end
    object btMic: TButton
      Left = 310
      Height = 44
      Top = 79
      Width = 100
      Caption = '🎤 Mic'
      OnClick = btMicClick
      TabOrder = 2
    end
  end
end
