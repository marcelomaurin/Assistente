program movement_timeline_tests;
{$mode objfpc}{$H+}
uses Classes,SysUtils,Math,fpjson,jsonparser,movement_timeline;
var Root:string;A,B:TMovementRuntime;J:TJSONObject;T:TMovementTimeline;I:Integer;Q:TMQuaternion;P:TMPoseArray;
procedure Check(V:Boolean;const Message:string);
begin if not V then raise Exception.Create(Message);end;
procedure Save(const Name,Text:string);
var L:TStringList;begin L:=TStringList.Create;try L.Text:=Text;L.SaveToFile(Root+Name);finally L.Free;end;end;
function Motion(const Text:string):TMovementTimeline;
var D:TJSONData;
begin D:=GetJSON(Text);try Result:=ParseMovementTimeline(TJSONObject(D));finally D.Free;end;end;
procedure Load(ObstacleY:Integer);
begin
  Save('rig.gltf','{"nodes":[{"name":"root","children":[1,3]},{"name":"arm","children":[2]},{"name":"hand","translation":[1,0,0]},{"name":"obstacle","translation":[0,'+IntToStr(ObstacleY)+',0]}]}');
  A.LoadRig(Root+'rig.gltf',Root+'collisions.json',1);B.LoadRig(Root+'rig.gltf',Root+'collisions.json',1);
end;
procedure Rejected(const Text:string);
var Bad:Boolean;
begin Bad:=False;try Motion(Text);except Bad:=True;end;Check(Bad,'Invalid motion accepted');end;
begin
  Root:=IncludeTrailingPathDelimiter(ExpandFileName(ParamStr(1)));ForceDirectories(Root);
  Save('collisions.json','{"version":1,"margin_height":0.001,"bodies":[{"id":"hand","start_bone":"hand","radius_height":0.08},{"id":"body","start_bone":"obstacle","radius_height":0.1}]}');
  A:=TMovementRuntime.Create;B:=TMovementRuntime.Create;
  try
    Load(5);
    T:=Motion('{"duration_ms":1000,"transition_ms":0,"interpolation":"linear","members":[{"bone":"arm","initial_rotation_deg":[0,0,0],"final_rotation_deg":[0,0,90]}]}');
    A.Start(T);A.Advance(500);Q:=A.Pose[1].Rotation;Check(Abs(Q[2]-Sin(Pi/8))<1E-7,'Midpoint is not 45 degrees');
    A.Advance(500);B.Start(T);for I:=1 to 60 do B.Advance(1000/60);
    Check(not A.Running and not B.Running,'Motion did not finish');
    for I:=0 to 3 do Check(Abs(A.Pose[1].Rotation[I]-B.Pose[1].Rotation[I])<1E-7,'FPS dependent pose');
    Load(1);T.Tracks[0].Keys[1].Rotation:=MQuaternion(0,0,180);
    A.Start(T);A.Advance(1000);
    Check((A.BlockedPair<>'') and (A.ElapsedMS<500) and not A.Running,'Motion tunneled through body');
    Check(A.MinimumClearance>=-1E-10,'Stopped pose is penetrating');
    B.Start(T);for I:=1 to 100 do begin B.Advance(10);Check(B.MinimumClearance>=-1E-10,'Intermediate pose penetrated');end;
    Check(Abs(A.ElapsedMS-B.ElapsedMS)<0.02,'Frame rate changed collision time');
    Load(1);
    T:=Motion('{"duration_ms":50,"transition_ms":0,"members":[{"bone":"arm","keyframes":[{"time_ms":0,"rotation_deg":[0,0,0]},{"time_ms":4,"rotation_deg":[0,0,180]},{"time_ms":8,"rotation_deg":[0,0,0]},{"time_ms":50,"rotation_deg":[0,0,0]}]}]}');
    A.Start(T);A.Advance(50);Check((A.BlockedPair<>'') and (A.ElapsedMS<4),'Internal keyframe collision was skipped');
    Load(5);
    T:=Motion('{"duration_ms":100,"transition_ms":50,"return_ms":100,"finish":"return","members":[{"bone":"arm","initial_rotation_deg":[0,0,0],"final_rotation_deg":[0,0,70]}]}');
    A.Start(T);A.Advance(250);Check(not A.Running and (Abs(A.Pose[1].Rotation[2])<1E-8),'Return did not restore incoming pose');
    Load(5);P:=A.RestPose;P[1].Rotation:=MQuaternion(0,0,30);A.Capture(P);
    T:=Motion('{"duration_ms":1000,"transition_ms":0,"interpolation":"linear","members":[{"bone":"arm","initial_rotation_deg":"current","final_rotation_deg":[0,0,90]}]}');
    A.Start(T);A.Advance(500);Check(Abs(A.Pose[1].Rotation[2]-Sin(Pi/6))<1E-7,'Current pose was not captured');
    B.Start(T);B.Advance(500);Check(Abs(B.Pose[1].Rotation[2]-Sin(Pi/8))<1E-7,'Captured pose mutated shared catalog');
    A.Capture(P);
    T:=Motion('{"duration_ms":1000,"transition_ms":0,"interpolation":"linear","members":[{"bone":"arm","keyframes":[{"time_ms":0,"rotation_deg":"current"},{"time_ms":1000,"rotation_deg":[0,0,90]}]}]}');
    A.Start(T);A.Advance(500);Check(Abs(A.Pose[1].Rotation[2]-Sin(Pi/6))<1E-7,'Keyframe did not capture current pose');
    Load(5);
    T:=Motion('{"duration_ms":1000,"transition_ms":0,"interpolation":"linear","members":[{"bone":"arm","start_ms":500,"duration_ms":500,"initial_rotation_deg":"current","final_rotation_deg":[0,0,90]},{"bone":"obstacle","duration_ms":500,"initial_rotation_deg":[0,0,0],"final_rotation_deg":[0,0,90]}]}');
    A.Start(T);A.Advance(500);Check(Abs(A.Pose[1].Rotation[2])<1E-8,'Delayed member started early');
    Check(Abs(A.Pose[3].Rotation[2]-Sin(Pi/4))<1E-7,'Parallel member did not finish');
    A.Advance(500);Check(Abs(A.Pose[1].Rotation[2]-Sin(Pi/4))<1E-7,'Delayed member did not finish');
    Load(5);
    T:=Motion('{"duration_ms":100,"transition_ms":0,"members":[{"bone":"arm","initial_position_height":[0,0,0],"final_position_height":[0,0.1,0]}]}');
    try A.Start(T);raise Exception.Create('Limb length mutation accepted');except on E:Exception do Check(Pos('Translacao proibida',E.Message)>0,E.Message);end;
    Rejected('{"duration_ms":100,"members":[{"bone":"arm","initial_scale":[1,1,1],"final_scale":[0,1,1]}]}');
    Rejected('{"duration_ms":20,"members":[{"bone":"arm","initial_rotation_deg":[0,0,0],"final_rotation_deg":[0,0,90]}]}');
    Rejected('{"duration_ms":100,"members":[{"bone":"arm","initial_rotation_deg":[0,0,0],"final_rotation_deg":[0,0,999]}]}');
    Rejected('{"duration_ms":100,"members":[{"bone":"arm","keyframes":[{"time_ms":0,"rotation_deg":[0,0,0]},{"time_ms":0,"rotation_deg":[0,0,90]}]}]}');
    Load(5);
    Save('reference.json','{"version":1,"reference_heights":{"'+ExtractFileName(ExcludeTrailingPathDelimiter(Root))+'":1},"translatable_members":["root"],"bodies":[{"id":"hand","start_bone":"hand","radius_height":0.08}]}');
    A.LoadRig(Root+'rig.gltf',Root+'reference.json',2);
    T:=Motion('{"duration_ms":100,"transition_ms":0,"members":[{"bone":"root","initial_position_height":[0,0,0],"final_position_height":[0,0.1,0]}]}');
    A.Start(T);A.Advance(100);Check(Abs(A.Pose[0].Position[1]-0.1)<1E-8,'Render bounds overrode fixed calibration height');
    WriteLn('PASS: SLERP, exact duration, 60/1000 FPS equivalence, swept body collision, no tunneling across internal keyframes, return, current pose isolation, staggered members, translation restrictions, fixed reference height and schema validation');
  finally A.Free;B.Free;end;
end.
